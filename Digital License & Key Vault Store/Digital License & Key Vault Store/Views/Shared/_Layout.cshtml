@using Microsoft.AspNetCore.Http
@{
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KeyVault</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background-color: #0b0f19; color: #e5e7eb; }
        .navbar { background-color: #0f172a; border-bottom: 1px solid #1f2937; }
        .vault-card { background-color: #111827; border: 1px solid #1f2937; transition: transform 0.15s ease, border-color 0.15s ease; }
        .vault-card:hover { transform: translateY(-3px); border-color: #6366f1; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg sticky-top">
	    <div class="container">
			<!-- <a class="navbar-brand fw-bold text-white" asp-controller="Store" asp-action="Index"> -->
		    <a class="navbar-brand fw-bold text-white" asp-controller="" asp-action="">
			    <i class="bi bi-shield-lock-fill text-primary me-2"></i>KeyVault - Digital License Store
		    </a>
		    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
			    <span class="navbar-toggler-icon"></span>
		    </button>
		    <div class="collapse navbar-collapse" id="mainNav">
			    <ul class="navbar-nav me-auto">
				    <li class="nav-item">
						<!-- <a class="nav-link" asp-controller="Store" asp-action="Index">Store</a> -->
					    <a class="nav-link" asp-controller="" asp-action="">Store</a>
				    </li>
				    @if (!string.IsNullOrEmpty(userName))
				    {
					    <li class="nav-item">
							<!-- a class="nav-link" asp-controller="Vault" asp-action="Index"> -->
						    <a class="nav-link" asp-controller="" asp-action="">
							    <i class="bi bi-key me-1"></i>My Vault
						    </a>
					    </li>
				    }
				    @if (userRole == "Admin" || userRole == "Staff")
				    {
					    <li class="nav-item">
							<!-- <a class="nav-link text-warning" asp-controller="Admin" asp-action="Products"> -->
						    <a class="nav-link text-warning" asp-controller="" asp-action="">
							    <i class="bi bi-gear me-1"></i>Admin Panel
						    </a>
					    </li>
				    }
			    </ul>
			    <div class="d-flex align-items-center gap-2">
				    @if (string.IsNullOrEmpty(userName))
				    {
						<!-- <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a> -->
					    <a class="btn btn-outline-light btn-sm" asp-controller="" asp-action="">Login</a>
						<!-- <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a> -->
					    <a class="btn btn-primary btn-sm" asp-controller="" asp-action="">Register</a>
				    }
				    else
				    {
					    <span class="text-secondary small me-2">
						    <i class="bi bi-person-circle me-1"></i>@userName (@userRole)
					    </span>
						<!-- <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">Logout</a> -->
					    <a class="btn btn-outline-danger btn-sm" asp-controller="" asp-action="">Logout</a>
				    }
			    </div>
		    </div>
	    </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="border-top border-secondary border-opacity-25 py-3 text-center text-secondary small">
		© 2026 KeyVault Digital License Store | All rights reserved | Developed by <a class="text-decoration-none fw-semibold text-primary" href="https://www.github.com/zuirez">Rashed</a> & <a class="text-decoration-none fw-semibold text-primary" href="https://www.github.com/junaidNahin">Nahin</a>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>