@model ProductsModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-3">
    <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-secondary small">
        <i class="bi bi-arrow-left me-1"></i>Back to Store
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card vault-card p-4 rounded-3">
            <span class="badge bg-secondary bg-opacity-25 text-info align-self-start mb-2">@Model.CategoryName</span>
            <h2 class="text-white fw-bold mb-3">@Model.Name</h2>
            <p class="text-secondary fs-6 mb-4">@Model.Description</p>

            <div class="border-top border-secondary border-opacity-25 pt-3">
                <h6 class="text-white mb-3">
                    <i class="bi bi-shield-check text-success me-2"></i>Vault Security Guarantees
                </h6>
                <ul class="list-unstyled text-secondary small mb-0 d-grid gap-2">
                    <li><i class="bi bi-lock-fill text-primary me-2"></i>Stored encrypted with AES-256 until you reveal it in your Vault.</li>
                    <li><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Row-locked checkout prevents duplicate key allocation.</li>
                    <li><i class="bi bi-journal-check text-info me-2"></i>Every key reveal is logged with IP and timestamp for your protection.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card vault-card p-4 rounded-3">
            <div class="text-secondary small">Instant Digital License</div>
            <div class="display-6 fw-bold text-white my-2">৳@Model.Price.ToString("N0")</div>

            <div class="mb-4">
                @if (Model.AvailableKeys > 0)
                {
                    <span class="badge bg-success bg-opacity-25 text-success px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i>@Model.AvailableKeys Keys Ready in Vault
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2">
                        <i class="bi bi-x-circle me-1"></i>Currently Out of Stock
                    </span>
                }
            </div>

            @if (Model.AvailableKeys > 0)
            {
                <a asp-controller="Checkout" asp-action="Index" asp-route-slug="@Model.Slug" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-cart-check me-2"></i>Buy Now
                </a>
            }
            else
            {
                <button class="btn btn-secondary btn-lg w-100" disabled>Out of Stock</button>
            }
        </div>
    </div>
</div>